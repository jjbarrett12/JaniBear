# App URL (no trailing slash). Used for auth redirect fallback and share links.
# For a single canonical host (www vs non-www), configure the redirect in Vercel/hosting, not here.
NEXT_PUBLIC_APP_URL=https://janibear.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Stripe Price IDs (create these in Stripe Dashboard for each plan)
STRIPE_CUB_PRICE_ID=price_xxxxx
STRIPE_BLACK_BEAR_PRICE_ID=price_xxxxx
STRIPE_GRIZZLY_PRICE_ID=price_xxxxx
STRIPE_KODIAK_PRICE_ID=price_xxxxx
